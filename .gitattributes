# 统一换行符，避免 Windows/Linux 协作时反复出现 CRLF 警告
* text=auto eol=lf

# Windows 脚本保持 CRLF（PowerShell 5.1 对 LF 支持有坑）
*.ps1 text eol=crlf
*.bat text eol=crlf

# 图片按二进制处理
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.wav binary
*.mp3 binary

# 题库与数据保持 LF
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# 不让 git 在 diff 里显示这些
*.pyc binary
